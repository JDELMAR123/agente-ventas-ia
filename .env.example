# Base de datos (Postgres). En local: la genera `npx prisma dev`.
DATABASE_URL=""
# Opcional, para producción con pooler (Neon, etc.) — conexión directa para migraciones.
DATABASE_URL_UNPOOLED=""

# Puerto del servidor
PORT="3300"

# Usuario/contraseña del panel /admin (Basic Auth). Cámbialos.
ADMIN_USER="admin"
ADMIN_PASSWORD="cambia-esto"

# --- Meta (WhatsApp / Instagram / Messenger) ---
# Se configuran aquí como respaldo, o desde /admin (lo de /admin tiene prioridad).
META_WEBHOOK_VERIFY_TOKEN=""
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
META_INSTAGRAM_TOKEN=""
META_INSTAGRAM_ACCOUNT_ID=""
META_MESSENGER_TOKEN=""
META_MESSENGER_PAGE_ID=""

# --- IA avanzada (opcional, de pago) ---
# Sin esto, el agente usa el motor de reglas gratis por defecto.
ANTHROPIC_API_KEY=""

# --- Escalamiento a humano ---
SLACK_WEBHOOK_URL=""
ESCALATION_EMAIL=""
