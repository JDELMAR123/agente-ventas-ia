// Esquema del Agente de Ventas — aprende más: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum MessageDirection {
  ENTRANTE
  SALIENTE
}

enum MessageSender {
  CLIENTE
  AGENTE
  HUMANO
}

enum LeadStage {
  NUEVO
  CONTACTADO
  NEGOCIANDO
  GANADO
  PERDIDO
}

enum ConversationStatus {
  ACTIVA
  PAUSADA // escalada a un humano: el agente deja de responder automáticamente
  CERRADA
}

enum FollowUpStatus {
  PENDIENTE
  ENVIADO
  CANCELADO
  FALLIDO // se intentó pero no se pudo enviar (ver ToolCallLog / alerta de Slack)
}

enum AppointmentStatus {
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

/// Configuración del negocio que compró este agente. Fila única (id = "singleton").
/// Nada de esto viene hardcodeado en el código — se edita desde /admin.
model Settings {
  id String @id @default("singleton")

  businessName String @default("Mi negocio")
  brandTone    String @default("cercano y profesional, sin exagerar con emojis")

  // Motor de IA: "rules" (gratis, por defecto) | "anthropic" (Claude, con clave propia del comprador)
  aiProvider        String  @default("rules")
  aiApiKey          String?
  aiModel           String  @default("claude-sonnet-5")
  aiBusinessContext String  @default("")

  // Reglas duras de negocio (el agente NUNCA las cruza, ver systemPrompt.ts)
  maxDescuentoPct   Int @default(0) // 0 = no autorizado a ofrecer descuentos

  // Escalamiento a humano
  slackWebhookUrl String?
  escalationEmail String?
  /// Credenciales SMTP para poder enviar de verdad a escalationEmail. Sin
  /// esto configurado, escalationEmail es solo un dato guardado — no se
  /// manda ningún correo (Slack sigue siendo el aviso principal).
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?

  // Canales (Meta)
  metaVerifyToken   String?
  /// App Secret de la app de Meta — para validar la firma X-Hub-Signature-256
  /// de cada webhook entrante. Sin esto, CUALQUIERA que conozca la URL del
  /// webhook puede mandar mensajes falsos que el agente procesa como reales.
  metaAppSecret     String?
  waToken           String?
  waPhoneId         String?
  igToken           String?
  igAccountId       String?
  messengerToken    String?
  messengerPageId   String?

  /// Plantilla de WhatsApp aprobada por Meta para el seguimiento automático
  /// fuera de la ventana de 24h. Sin esto, un seguimiento fuera de ventana
  /// NO se envía (Meta lo rechazaría) — solo se avisa por Slack.
  /// Se registra y aprueba en Meta Business Manager, no aquí. Ver docs/META_SETUP.md.
  waFollowUpTemplateName String?
  waFollowUpTemplateLang String  @default("es")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catálogo real de productos/servicios. La tool consultar_catalogo SOLO lee de
/// aquí — el agente nunca inventa precios ni disponibilidad.
model Product {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  price       Float?
  sku         String?
  keywords    String   @default("[]") // JSON: sinónimos para que el agente lo reconozca
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model Contact {
  id      String  @id @default(cuid())
  name    String?
  phone   String? @unique
  email   String?
  company String?
  notes   String?

  whatsappId  String? @unique
  instagramId String? @unique
  messengerId String? @unique

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  leads         Lead[]
  sales         Sale[]
  appointments  Appointment[]
}

model Conversation {
  id         String      @id @default(cuid())
  channel    ChannelType
  externalId String // id de la conversación/hilo en el canal de origen
  contactId  String
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status             ConversationStatus @default(ACTIVA)
  lastMessageAt      DateTime           @default(now())
  lastMessagePreview String?

  messages     Message[]
  followUps    FollowUp[]
  toolCalls    ToolCallLog[]
  sales        Sale[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalId])
  @@index([lastMessageAt])
  @@index([status])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  sender         MessageSender    @default(CLIENTE)
  body           String
  externalId     String?          @unique
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/// Un lead por contacto (se actualiza in-place, no se duplica).
model Lead {
  id        String    @id @default(cuid())
  contactId String    @unique
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage     LeadStage @default(NUEVO)
  interes   String? // qué quiere / resumen corto
  valorEst  Float? // valor estimado de la venta, si se conoce

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
}

model FollowUp {
  id             String         @id @default(cuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  reason         String
  status         FollowUpStatus @default(PENDIENTE)
  sentAt         DateTime?

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
}

/// Una venta cerrada por el agente (tool registrar_venta). Distinto de
/// Lead.stage=GANADO: eso es solo una etapa del embudo, esto es el registro
/// concreto de qué se vendió, cuánto y cómo se pagó — lo que un negocio
/// necesita para un reporte de ventas real.
model Sale {
  id             String        @id @default(cuid())
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  items      String // JSON: [{ nombre, cantidad, precioUnitario }]
  total      Float
  metodoPago String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([createdAt])
}

/// Una cita/reserva (tool agendar_cita) — distinto de FollowUp, que es un
/// recordatorio interno para que el AGENTE vuelva a escribir, no una
/// reserva real con el cliente (mesa, turno de servicio, etc.).
model Appointment {
  id             String            @id @default(cuid())
  contactId      String
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  scheduledFor DateTime
  durationMin  Int      @default(60)
  servicio     String?
  status       AppointmentStatus @default(CONFIRMADA)

  createdAt DateTime @default(now())

  @@index([scheduledFor])
  @@index([contactId])
}

/// Observabilidad: registro de cada llamada a una tool que hace el agente.
model ToolCallLog {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  engine         String // "rules" | "anthropic"
  toolName       String
  args           String // JSON
  result         String // JSON
  ok             Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([toolName])
}
